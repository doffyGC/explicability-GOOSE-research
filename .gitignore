# Ignore cache files
__pycache__/

# Generated experimental runs are large and reproducible from the versioned
# matrix plan. Keep manifests/reports, not per-run CSVs and logs.
/data/runs/
/data/runs-matrix-smoke/
/data/validation-smoke/

# Training outputs. `grouped_predictions.csv` is ~1.3-1.6 GB per run and is
# reproducible from the hash-bound dataset + persisted splits. The reports
# derived from these runs (leakage_audit, prediction_integrity,
# benign_confusion, validation_protocol results) are versioned instead.
/results/

# Legacy dataset behind the submitted paper: 561 MB CSV plus its annotated
# Parquet. Provenance and limits are documented in data_card.md.
/data/CSV files/*.csv
/data/CSV files/*.parquet

CLAUDE.md
